{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": { "obsidian": ["node_modules/obsidian"] },
    "target": "es2018",
    "module": "esnext",
    "moduleResolution": "node",
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": ["dom", "es2018"],
    "types": ["node"],
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}
